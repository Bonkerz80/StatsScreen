<Window x:Class="StatsScreen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats Screen"
        Width="800"
        Height="600"
        MinWidth="200"
        MinHeight="150"
        Background="#080A0D"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewMouseRightButtonDown="Window_OnPreviewMouseRightButtonDown">
    <Window.Resources>
        <ContextMenu x:Key="DashboardContextMenu"
                     Style="{StaticResource StatsContextMenuStyle}" />
    </Window.Resources>

    <Grid Background="#080A0D">
        <Viewbox Stretch="Uniform"
                 StretchDirection="Both">
            <Grid Width="800"
                  Height="600"
                  Background="#080A0D">
                <Grid.RowDefinitions>
                    <RowDefinition Height="368" />
                    <RowDefinition Height="168" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="18,10,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            DataContext="{Binding CpuTemperature}"
                            Background="#121A22"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            ToolTip="{Binding SourceText}">
                        <Grid Margin="22,18,22,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="CPU"
                                       Foreground="{Binding AccentBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding ValueText}"
                                           Style="{StaticResource TemperatureValueTextStyle}"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="84"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="9,0,0,10"
                                           Text="{Binding UnitText}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <ProgressBar Grid.Row="2"
                                         Margin="4,0,4,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding TemperaturePercent, Mode=OneWay}"
                                         Style="{StaticResource TemperatureBarStyle}"
                                         IsHitTestVisible="False" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,9,0,0"
                                       Text="{Binding DetailText}"
                                       Foreground="#7D8E9D"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            DataContext="{Binding GpuTemperature}"
                            Background="#121A22"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            ToolTip="{Binding SourceText}">
                        <Grid Margin="22,18,22,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="GPU"
                                       Foreground="{Binding AccentBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding ValueText}"
                                           Style="{StaticResource TemperatureValueTextStyle}"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="84"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="9,0,0,10"
                                           Text="{Binding UnitText}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <ProgressBar Grid.Row="2"
                                         Margin="4,0,4,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding TemperaturePercent, Mode=OneWay}"
                                         Style="{StaticResource TemperatureBarStyle}"
                                         IsHitTestVisible="False" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,9,0,0"
                                       Text="{Binding DetailText}"
                                       Foreground="#7D8E9D"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="18,0,18,8"
                        Background="#10151C"
                        BorderBrush="#293542"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid Margin="26,10,26,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    DataContext="{Binding CpuPower}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding SourceText}">
                            <TextBlock Text="CPU POWER"
                                       Foreground="{Binding AccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <StackPanel Margin="0,1,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding ValueText}"
                                           Foreground="#F1F5F8"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="61"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="8,0,0,8"
                                           Text="{Binding UnitText}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <Border Height="2"
                                    Width="108"
                                    Margin="0,8,0,0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="1" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="1"
                                Margin="0,8"
                                Background="#293542" />

                        <StackPanel Grid.Column="2"
                                    DataContext="{Binding GpuPower}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding SourceText}">
                            <TextBlock Text="GPU POWER"
                                       Foreground="{Binding AccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <StackPanel Margin="0,1,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding ValueText}"
                                           Foreground="#F1F5F8"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="61"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="8,0,0,8"
                                           Text="{Binding UnitText}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" />
                            </StackPanel>
                            <Border Height="2"
                                    Width="108"
                                    Margin="0,8,0,0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="1" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="18,0,18,12"
                        Background="#0E141B"
                        BorderBrush="#25323E"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid Margin="22,5,22,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.6*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="2.6*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CPU"
                                       Foreground="#637486"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CpuHardwareText}"
                                       Foreground="{Binding CpuHardwareBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CpuHardwareText}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Foreground="#8A9AAA"
                                   FontFamily="Cascadia Mono,Consolas"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="GPU"
                                       Foreground="#637486"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding GpuHardwareText}"
                                       Foreground="{Binding GpuHardwareBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Right"
                                       ToolTip="{Binding GpuHardwareText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
