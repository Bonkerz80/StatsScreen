<Window x:Class="StatsScreen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats Screen"
        Icon="/StatsScreen;component/Resources/StatsScreen.ico"
        Width="800"
        Height="600"
        MinWidth="200"
        MinHeight="150"
        Background="#080B10"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewMouseRightButtonDown="Window_OnPreviewMouseRightButtonDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="DashboardBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Offset="0" Color="#0B1118" />
            <GradientStop Offset="0.52" Color="#080C12" />
            <GradientStop Offset="1" Color="#06090D" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TemperatureCardBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Offset="0" Color="#121B25" />
            <GradientStop Offset="1" Color="#0E151E" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PowerPanelBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Offset="0" Color="#101923" />
            <GradientStop Offset="1" Color="#0C131B" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DashboardMutedTextBrush" Color="#7E8E9E" />
        <SolidColorBrush x:Key="DashboardQuietTextBrush" Color="#536576" />
        <SolidColorBrush x:Key="DashboardCardBorderBrush" Color="#1C2A37" />
        <SolidColorBrush x:Key="DashboardSeparatorBrush" Color="#263746" />
        <ContextMenu x:Key="DashboardContextMenu"
                     Style="{StaticResource StatsContextMenuStyle}" />
    </Window.Resources>

    <Grid Background="{StaticResource DashboardBackgroundBrush}">
        <Viewbox Stretch="Uniform"
                 StretchDirection="Both">
            <Grid Width="800"
                  Height="600"
                  Background="{StaticResource DashboardBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="350" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="22,18,22,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            DataContext="{Binding CpuTemperature}"
                            Background="{StaticResource TemperatureCardBrush}"
                            BorderBrush="{StaticResource DashboardCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            ToolTip="{Binding SourceText}">
                        <Grid>
                            <Border Height="3"
                                    Margin="1,1,1,0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="13,13,0,0"
                                    VerticalAlignment="Top" />
                            <Border Width="2"
                                    Height="38"
                                    Margin="22,22,0,0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Opacity="0.85" />
                            <Grid Margin="24,21,24,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="CPU"
                                               Foreground="{Binding AccentBrush}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,1,0,0"
                                               Text="TEMPERATURE"
                                               Foreground="{StaticResource DashboardMutedTextBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="174" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ValueText}"
                                               Style="{StaticResource TemperatureValueTextStyle}"
                                               FontFamily="Cascadia Mono,Consolas"
                                               FontSize="78"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,9"
                                               Text="{Binding UnitText}"
                                               Foreground="{Binding AccentBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Bottom" />
                                </Grid>

                                <ProgressBar Grid.Row="2"
                                             Height="7"
                                             Margin="18,0,18,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding TemperaturePercent, Mode=OneWay}"
                                             Style="{StaticResource TemperatureBarStyle}"
                                             IsHitTestVisible="False" />

                                <StackPanel Grid.Row="3"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <TextBlock Text="SOURCE"
                                               Foreground="{StaticResource DashboardQuietTextBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0"
                                               Text="{Binding DetailText}"
                                               Foreground="{Binding AccentBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            DataContext="{Binding GpuTemperature}"
                            Background="{StaticResource TemperatureCardBrush}"
                            BorderBrush="{StaticResource DashboardCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            ToolTip="{Binding SourceText}">
                        <Grid>
                            <Border Height="3"
                                    Margin="1,1,1,0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="13,13,0,0"
                                    VerticalAlignment="Top" />
                            <Border Width="2"
                                    Height="38"
                                    Margin="22,22,0,0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Opacity="0.85" />
                            <Grid Margin="24,21,24,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="GPU"
                                               Foreground="{Binding AccentBrush}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,1,0,0"
                                               Text="TEMPERATURE"
                                               Foreground="{StaticResource DashboardMutedTextBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="174" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ValueText}"
                                               Style="{StaticResource TemperatureValueTextStyle}"
                                               FontFamily="Cascadia Mono,Consolas"
                                               FontSize="78"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,9"
                                               Text="{Binding UnitText}"
                                               Foreground="{Binding AccentBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Bottom" />
                                </Grid>

                                <ProgressBar Grid.Row="2"
                                             Height="7"
                                             Margin="18,0,18,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding TemperaturePercent, Mode=OneWay}"
                                             Style="{StaticResource TemperatureBarStyle}"
                                             IsHitTestVisible="False" />

                                <StackPanel Grid.Row="3"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <TextBlock Text="SOURCE"
                                               Foreground="{StaticResource DashboardQuietTextBrush}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0"
                                               Text="{Binding DetailText}"
                                               Foreground="{Binding AccentBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="22,0,22,8"
                        Background="{StaticResource PowerPanelBrush}"
                        BorderBrush="{StaticResource DashboardCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid Margin="26,14,26,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    DataContext="{Binding CpuPower}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding SourceText}">
                            <TextBlock Text="CPU POWER"
                                       Foreground="{Binding AccentBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <Grid Margin="0,1,0,0"
                                  HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="31" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ValueText}"
                                           Foreground="#F1F5F8"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="51"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,7"
                                           Text="{Binding UnitText}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                            <Border Height="2"
                                    Width="118"
                                    Margin="0,5,0,0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="1"
                                    Opacity="0.9" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Height="46"
                                VerticalAlignment="Center"
                                Background="{StaticResource DashboardSeparatorBrush}"
                                Opacity="0.55" />

                        <StackPanel Grid.Column="2"
                                    DataContext="{Binding GpuPower}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding SourceText}">
                            <TextBlock Text="GPU POWER"
                                       Foreground="{Binding AccentBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <Grid Margin="0,1,0,0"
                                  HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="31" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ValueText}"
                                           Foreground="#F1F5F8"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="51"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,7"
                                           Text="{Binding UnitText}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                            <Border Height="2"
                                    Width="118"
                                    Margin="0,5,0,0"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="1"
                                    Opacity="0.9" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="22,0,22,18"
                        Background="#0C131B"
                        BorderBrush="{StaticResource DashboardCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid Margin="18,9,18,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.8*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="2.8*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Width="3"
                                    Height="30"
                                    Background="{Binding CpuHardwareBrush}"
                                    CornerRadius="1.5"
                                    VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="CPU"
                                           Foreground="{StaticResource DashboardQuietTextBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CpuHardwareText}"
                                           Foreground="{Binding CpuHardwareBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CpuHardwareText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="LIVE TELEMETRY"
                                       Foreground="{StaticResource DashboardQuietTextBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding StatusLabel}"
                                       Foreground="#9AA9B7"
                                       FontFamily="Cascadia Mono,Consolas"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="GPU"
                                           Foreground="{StaticResource DashboardQuietTextBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding GpuHardwareText}"
                                           Foreground="{Binding GpuHardwareBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding GpuHardwareText}" />
                            </StackPanel>
                            <Border Width="3"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Background="{Binding GpuHardwareBrush}"
                                    CornerRadius="1.5"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
