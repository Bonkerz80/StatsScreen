<Window x:Class="StatsScreen.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats Screen Settings"
        Width="560"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14"
        Foreground="#F4F7FA"
        FontFamily="Segoe UI">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="DISPLAY SETTINGS"
                   Foreground="#FFFFFF"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,22"
                   Text="Choose the monitor used by dedicated display mode."
                   Foreground="#AEBCC9"
                   FontSize="14" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="MONITOR"
                       Foreground="#DDE7EF"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="MonitorComboBox"
                      Margin="0,8,0,0"
                      DisplayMemberPath="DisplayLabel"
                      Style="{StaticResource StatsComboBoxStyle}"
                      SelectionChanged="MonitorComboBox_OnSelectionChanged" />
            <TextBlock x:Name="MonitorHintText"
                       Margin="0,9,0,0"
                       Foreground="#AEBCC9"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,24,0,0">
            <CheckBox x:Name="StartInDisplayModeCheckBox"
                      Content="Start in dedicated display mode"
                      Style="{StaticResource StatsCheckBoxStyle}" />
            <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Foreground="#DDE7EF"
                           FontSize="14"
                           Text="Polling interval (ms)" />
                <TextBox x:Name="PollingIntervalTextBox"
                         Width="100"
                         Margin="18,0,0,0"
                         HorizontalContentAlignment="Right"
                         Text="1000"
                         Style="{StaticResource StatsTextBoxStyle}" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0"
                       Text="F11 toggles dedicated display mode · Esc exits it"
                       Foreground="#AEBCC9"
                       FontSize="13" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Margin="0,0,12,0"
                    Content="Cancel"
                    Click="CancelButton_OnClick"
                    Style="{StaticResource SettingsButtonStyle}" />
            <Button Width="96"
                    Content="Save"
                    Click="SaveButton_OnClick"
                    Style="{StaticResource SettingsPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
