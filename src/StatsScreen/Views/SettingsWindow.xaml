<Window x:Class="StatsScreen.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats Screen Settings"
        Width="510"
        Height="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14"
        Foreground="#E7EDF4"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="DISPLAY SETTINGS"
                   Foreground="#F4F7FA"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,5,0,18"
                   Text="Choose the monitor used by dedicated display mode."
                   Foreground="#7F8C9A"
                   FontSize="13" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="MONITOR"
                       Foreground="#8EA0B1"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="MonitorComboBox"
                      Margin="0,6,0,0"
                      DisplayMemberPath="DisplayLabel"
                      SelectionChanged="MonitorComboBox_OnSelectionChanged" />
            <TextBlock x:Name="MonitorHintText"
                       Margin="0,7,0,0"
                       Foreground="#657384"
                       FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,19,0,0">
            <CheckBox x:Name="StartInDisplayModeCheckBox"
                      Content="Start in dedicated display mode"
                      Foreground="#DCE5ED"
                      FontSize="14" />
            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Foreground="#8EA0B1"
                           FontSize="13"
                           Text="Polling interval (ms)" />
                <TextBox x:Name="PollingIntervalTextBox"
                         Width="90"
                         Margin="15,0,0,0"
                         HorizontalContentAlignment="Right"
                         Text="1000" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0"
                       Text="F11 toggles dedicated display mode · Esc exits it"
                       Foreground="#596676"
                       FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    Click="CancelButton_OnClick"
                    Style="{StaticResource SettingsButtonStyle}" />
            <Button Width="90"
                    Content="Save"
                    Click="SaveButton_OnClick"
                    Style="{StaticResource SettingsButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
