<UserControl x:Class="StatsScreen.Views.SensorTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border Margin="4"
            Padding="1"
            Background="#10151C"
            BorderBrush="#28323D"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Rectangle Height="4"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       Fill="{Binding Accent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Opacity="0.9" />
            <StackPanel Margin="18,25,18,17"
                        VerticalAlignment="Stretch">
                <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#AAB7C6"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <StackPanel Margin="0,19,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Text="{Binding ValueText}"
                               Foreground="#F4F7FA"
                               FontFamily="Cascadia Mono,Consolas"
                               FontSize="58"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               ToolTip="{Binding SourceText}" />
                    <TextBlock Margin="9,0,0,4"
                               Text="{Binding UnitText}"
                               Foreground="#8F9DAD"
                               FontFamily="Segoe UI"
                               FontSize="22"
                               FontWeight="SemiBold"
                               VerticalAlignment="Bottom" />
                </StackPanel>
                <Border Height="1"
                        Margin="28,16,28,0"
                        Background="#242D37" />
                <TextBlock Margin="0,12,0,0"
                           Text="{Binding DetailText}"
                           Foreground="#9CAABA"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
