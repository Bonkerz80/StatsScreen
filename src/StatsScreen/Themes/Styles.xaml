<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="StatsMenuColourBorderBrush" Color="#526170" />

    <Style x:Key="TemperatureValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding TemperatureValueBrush}" />
    </Style>

    <Style x:Key="TemperatureBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="#202A34" />
        <Setter Property="Foreground" Value="{Binding TemperatureBarBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="6" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatsContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="#131A22" />
        <Setter Property="Foreground" Value="#E8EEF4" />
        <Setter Property="BorderBrush" Value="#3A4A59" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <Style x:Key="StatsMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#E8EEF4" />
        <Setter Property="Background" Value="#131A22" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="245" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#273847" />
                <Setter Property="BorderBrush" Value="#425B70" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#657281" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatsMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="#2A3744" />
    </Style>

    <Style x:Key="SettingsButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#E7EDF4" />
        <Setter Property="Background" Value="#1B232C" />
        <Setter Property="BorderBrush" Value="#364351" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#263441" />
                            <Setter Property="BorderBrush" Value="#4B6478" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#14202A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="#E7EDF4" />
        <Setter Property="Background" Value="#121820" />
        <Setter Property="BorderBrush" Value="#364351" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="#E7EDF4" />
        <Setter Property="Background" Value="#121820" />
        <Setter Property="BorderBrush" Value="#364351" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</ResourceDictionary>
