<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="StatsMenuColourBorderBrush" Color="#526170" />
    <SolidColorBrush x:Key="StatsControlBackgroundBrush" Color="#151D26" />
    <SolidColorBrush x:Key="StatsControlBorderBrush" Color="#526779" />
    <SolidColorBrush x:Key="StatsControlForegroundBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="StatsControlSecondaryTextBrush" Color="#AEBCC9" />
    <SolidColorBrush x:Key="StatsControlHoverBrush" Color="#263A4A" />
    <SolidColorBrush x:Key="StatsControlFocusBrush" Color="#4DC6C7" />
    <SolidColorBrush x:Key="StatsControlSelectionBrush" Color="#2E6E8D" />
    <SolidColorBrush x:Key="StatsButtonBackgroundBrush" Color="#1B2833" />
    <SolidColorBrush x:Key="StatsButtonPrimaryBrush" Color="#1E3A46" />
    <SolidColorBrush x:Key="StatsButtonPrimaryBorderBrush" Color="#4C96A5" />

    <Style x:Key="TemperatureValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding TemperatureValueBrush}" />
    </Style>

    <Style x:Key="TemperatureBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="#202A34" />
        <Setter Property="Foreground" Value="{Binding TemperatureBarBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="6" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatsContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="#131A22" />
        <Setter Property="Foreground" Value="#E8EEF4" />
        <Setter Property="BorderBrush" Value="#3A4A59" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <Style x:Key="StatsMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#E8EEF4" />
        <Setter Property="Background" Value="#131A22" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="245" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#273847" />
                <Setter Property="BorderBrush" Value="#425B70" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#657281" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatsMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="#2A3744" />
    </Style>

    <ControlTemplate x:Key="StatsComboBoxToggleButtonTemplate"
                     TargetType="{x:Type ToggleButton}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <Path Width="9"
                  Height="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M 0,0 L 9,0 L 4.5,6 Z"
                  Fill="{TemplateBinding Foreground}"
                  Stretch="Fill" />
        </Border>
    </ControlTemplate>

    <Style x:Key="StatsComboBoxItemStyle"
           TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{StaticResource StatsControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource StatsControlForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource StatsControlSelectionBrush}" />
                            <Setter TargetName="ItemBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource StatsControlHoverBrush}" />
                            <Setter TargetName="ItemBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlBorderBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#121820" />
                            <Setter TargetName="ItemBorder"
                                    Property="BorderBrush"
                                    Value="#3C4A56" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource StatsControlSecondaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatsComboBoxStyle"
           TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{StaticResource StatsControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource StatsControlForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatsControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0,40,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Height" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource StatsComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <ToggleButton x:Name="DropDownToggle"
                                              Width="34"
                                              HorizontalAlignment="Right"
                                              Focusable="False"
                                              ClickMode="Press"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              Foreground="{TemplateBinding Foreground}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Template="{StaticResource StatsComboBoxToggleButtonTemplate}" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Slide"
                               StaysOpen="False">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="250"
                                    Margin="0,4,0,0"
                                    Background="{StaticResource StatsControlBackgroundBrush}"
                                    BorderBrush="{StaticResource StatsControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Focusable="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder"
                                    Property="Background"
                                    Value="{StaticResource StatsControlHoverBrush}" />
                            <Setter TargetName="OuterBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                            <Setter TargetName="OuterBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="OuterBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                            <Setter TargetName="DropDownToggle"
                                    Property="Foreground"
                                    Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBorder"
                                    Property="Background"
                                    Value="#121820" />
                            <Setter TargetName="OuterBorder"
                                    Property="BorderBrush"
                                    Value="#3C4A56" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource StatsControlSecondaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatsTextBoxStyle"
           TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource StatsControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="#F7F9FB" />
        <Setter Property="BorderBrush" Value="{StaticResource StatsControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="SelectionBrush" Value="{StaticResource StatsControlSelectionBrush}" />
        <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
        <Setter Property="CaretBrush" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxBorder"
                                    Property="Background"
                                    Value="#121820" />
                            <Setter TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="#3C4A56" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource StatsControlSecondaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatsCheckBoxStyle"
           TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource StatsControlForegroundBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="CheckBorder"
                                    Width="20"
                                    Height="20"
                                    Background="{StaticResource StatsControlBackgroundBrush}"
                                    BorderBrush="{StaticResource StatsControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Path x:Name="CheckMark"
                                      Margin="3"
                                      Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 1,8 L 6,13 L 16,3"
                                      Stroke="#FFFFFF"
                                      Stretch="Uniform"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder"
                                    Property="Background"
                                    Value="{StaticResource StatsControlSelectionBrush}" />
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                            <Setter TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder"
                                    Property="Background"
                                    Value="{StaticResource StatsControlHoverBrush}" />
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="#FFFFFF" />
                            <Setter TargetName="CheckBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckBorder"
                                    Property="Background"
                                    Value="#1A2B37" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder"
                                    Property="Background"
                                    Value="#121820" />
                            <Setter TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="#3C4A56" />
                            <Setter TargetName="CheckMark"
                                    Property="Stroke"
                                    Value="{StaticResource StatsControlSecondaryTextBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource StatsControlSecondaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource StatsControlForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource StatsButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatsControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource StatsControlHoverBrush}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource StatsControlFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#14202A" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#FFFFFF" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#121820" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#3C4A56" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource StatsControlSecondaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SettingsButtonStyle}">
        <Setter Property="Background" Value="{StaticResource StatsButtonPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatsButtonPrimaryBorderBrush}" />
    </Style>
</ResourceDictionary>
